@namespace SmartGirlAlgebra.Components
@using System.Text
@using System.Globalization
@using SmartGirlAlgebra.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Reads the instructions out loud and lights up each word as it is said, for a
   child who cannot read them yet.

   When Listen is on, the last word is left out. It flashes on screen, he says
   it, and we tell him whether he got it - the difference between being read to
   and being taught to read. If he misses it, or the microphone isn't available,
   he hears the sentence again with the word said slowly and then repeated. He
   is never left stuck and never told he was wrong.

   Any word can also be tapped on its own to hear it.

   Emoji are shown but not spoken: a voice announcing "dog face dog face dog
   face" is noise, and the pictures are doing their own work. *@

<div class="sga-read">

    @for (var li = 0; li < Lines.Count; li++)
    {
        var line = li;
        <p class="@Lines[line].Class sga-prewrap">
            @foreach (var tok in _tokens.Where(t => t.Line == line))
            {
                var t = tok;

                if (t.Spoken >= 0)
                {
                    <button type="button"
                            class="sga-read__w @WordClass(t)"
                            aria-label="Hear the word @t.Text"
                            @onclick="@(() => Say(t))">@t.Text</button>
                }
                else
                {
                    @t.Text
                }

                @t.Sep
            }
        </p>
    }

    @if (_step == Step.Listening)
    {
        <p class="sga-read__turn" aria-live="polite">
            <span class="sga-read__mic" aria-hidden="true">🎤</span>
            Your turn — say the flashing word!
        </p>
    }
    else if (_step == Step.Praise)
    {
        <p class="sga-read__turn sga-read__turn--yes" aria-live="polite">
            <span aria-hidden="true">🌟</span> You read it!
        </p>
    }
    else if (_step == Step.Correct)
    {
        <p class="sga-read__turn" aria-live="polite">
            <span aria-hidden="true">👂</span> Listen — I'll say it for you.
        </p>
    }

    <button type="button"
            class="sga-readbtn @(_busy ? "sga-readbtn--on" : "")"
            aria-label="@(_busy ? "Stop reading" : "Read the instructions out loud")"
            @onclick="Toggle">
        <span class="sga-readbtn__icon @(_busy ? "sga-readbtn__icon--on" : "")" aria-hidden="true">
            @(_busy ? "⏹️" : "🔊")
        </span>
        <span>@ButtonLabel</span>
    </button>

    <p class="sga-read__nudge">👆 You can tap any word to hear it.</p>

    @if (_unsupported)
    {
        <p class="sga-read__nope">This tablet can't read out loud. Ask a grown-up!</p>
    }

</div>

@code {
    /// <summary>A block of text to show, with the CSS class it is normally shown in.</summary>
    public sealed record Line(string Text, string Class);

    [Parameter, EditorRequired] public IReadOnlyList<Line> Lines { get; set; } = [];

    /// <summary>Slower than an adult would read it. Kindergarten pace.</summary>
    [Parameter] public double Rate { get; set; } = 0.75;

    /// <summary>Leave the last word out and listen for him to read it.</summary>
    [Parameter] public bool Listen { get; set; }

    private enum Step { Idle, Clue, Listening, Praise, Correct, Reading }

    private sealed record Tok(int Line, string Text, string Sep, int Spoken, string Say);

    private List<Tok> _tokens = [];
    private string _clue = "";
    private int[] _clueStarts = [];
    private int _target = -1;          // index into the spoken words
    private string _targetWord = "";
    private string _signature = "";

    private Step _step = Step.Idle;
    private int _at = -1;
    private int _tapped = -1;
    private bool _unsupported;
    private bool _micRefused;

    private bool _busy => _step is not Step.Idle;

    private string ButtonLabel => _step switch
    {
        Step.Clue or Step.Reading => "Stop",
        Step.Listening => "Listening…",
        Step.Praise or Step.Correct => "Stop",
        _ => Listen ? "Read it with me" : "Read it to me"
    };

    private DotNetObjectReference<ReadAloud>? _self;

    protected override void OnParametersSet()
    {
        // Only re-tokenise when the words actually change, or every re-render
        // during speech would rebuild the map underneath the highlight.
        var sig = string.Join("", Lines.Select(l => l.Text));
        if (sig == _signature) return;

        _signature = sig;
        _step = Step.Idle;
        _at = -1;
        _tapped = -1;
        Build();
    }

    private string WordClass(Tok t)
    {
        if (t.Spoken == _tapped) return "sga-read__w--now";
        if (t.Spoken == _at && _step is Step.Clue or Step.Reading) return "sga-read__w--now";

        // The word he has to read flashes while we wait for him.
        if (t.Spoken == _target && _step is Step.Listening) return "sga-read__w--flash";
        if (t.Spoken == _target && _step is Step.Praise) return "sga-read__w--got";
        if (t.Spoken == _target && _step is Step.Correct) return "sga-read__w--now";

        return "";
    }

    private void Build()
    {
        _tokens = [];
        var speech = new StringBuilder();
        var starts = new List<int>();
        var words = new List<string>();

        for (var li = 0; li < Lines.Count; li++)
        {
            var text = Lines[li].Text ?? "";
            var i = 0;

            while (i < text.Length)
            {
                // A token is a run of non-space; the whitespace after it is kept
                // verbatim so line breaks and blank lines survive.
                var wordStart = i;
                while (i < text.Length && !char.IsWhiteSpace(text[i])) i++;
                var word = text[wordStart..i];

                var sepStart = i;
                while (i < text.Length && char.IsWhiteSpace(text[i])) i++;
                var sep = text[sepStart..i];

                if (word.Length == 0)
                {
                    if (sep.Length > 0) _tokens.Add(new Tok(li, "", sep, -1, ""));
                    continue;
                }

                var say = Sayable(word);
                var spokenIndex = -1;

                if (say.Length > 0)
                {
                    if (speech.Length > 0) speech.Append(' ');
                    starts.Add(speech.Length);
                    speech.Append(say);
                    words.Add(say);
                    spokenIndex = starts.Count - 1;
                }

                _tokens.Add(new Tok(li, word, sep, spokenIndex, say));
            }

            // A pause between the instruction and the question - but only if the
            // line didn't already end in something the voice will pause on.
            if (li < Lines.Count - 1 && speech.Length > 0 && !".!?:;".Contains(speech[^1]))
            {
                speech.Append('.');
            }
        }

        _target = -1;
        _targetWord = "";

        if (Listen)
        {
            // The last real word he can be asked to read. "Up" or "a" is no test,
            // so walk back to something with letters worth sounding out.
            for (var k = words.Count - 1; k >= 0; k--)
            {
                if (words[k].Count(char.IsLetter) < 3) continue;
                _target = k;
                _targetWord = words[k];
                break;
            }
        }

        if (_target >= 0)
        {
            // Everything except the word he has to read.
            var clue = new StringBuilder();
            var clueStarts = new List<int>();

            for (var k = 0; k < words.Count; k++)
            {
                if (k == _target) continue;
                if (clue.Length > 0) clue.Append(' ');
                clueStarts.Add(clue.Length);
                clue.Append(words[k]);
            }

            _clue = clue.ToString();
            _clueStarts = clueStarts.ToArray();
        }
        else
        {
            _clue = speech.ToString();
            _clueStarts = starts.ToArray();
        }
    }

    /// <summary>Drops emoji and other pictographs, keeping what a voice can read.</summary>
    private static string Sayable(string word)
    {
        var sb = new StringBuilder(word.Length);

        for (var i = 0; i < word.Length; i++)
        {
            var c = word[i];

            // Emoji are surrogate pairs - skip both halves together.
            if (char.IsHighSurrogate(c)) { i++; continue; }
            if (char.IsLowSurrogate(c)) continue;

            var cat = CharUnicodeInfo.GetUnicodeCategory(c);
            if (cat is UnicodeCategory.OtherSymbol or UnicodeCategory.NonSpacingMark) continue;

            sb.Append(c);
        }

        var result = sb.ToString().Trim();
        return result.Any(char.IsLetterOrDigit) ? result : "";
    }

    // ---------------------------------------------------------------- actions

    private async Task Toggle()
    {
        if (_busy)
        {
            await StopAll();
            return;
        }

        if (_clueStarts.Length == 0) return;

        _self ??= DotNetObjectReference.Create(this);
        _step = Listen && _target >= 0 ? Step.Clue : Step.Reading;
        _at = -1;

        await Speak(_clue, _clueStarts);
    }

    private async Task Speak(string text, int[] starts)
    {
        try { await Invoke("sgaSpeech.speak", text, starts, _self, Rate); }
        catch
        {
            _step = Step.Idle;
            _unsupported = true;
        }
    }

    /// <summary>
    /// Touch browsers only allow speech from inside the gesture, and an awaited
    /// interop call can land after it has expired. Use the synchronous path when
    /// the runtime offers one.
    /// </summary>
    private async Task Invoke(string fn, params object?[] args)
    {
        if (JS is IJSInProcessRuntime inProcess) inProcess.InvokeVoid(fn, args);
        else await JS.InvokeVoidAsync(fn, args);
    }

    private async Task Say(Tok tok)
    {
        if (tok.Say.Length == 0) return;

        _self ??= DotNetObjectReference.Create(this);

        // A tapped word interrupts whatever was happening, including his turn.
        if (_busy) await StopAll();

        _tapped = tok.Spoken;

        try { await Invoke("sgaSpeech.say", tok.Say, 0.5, _self); }
        catch { _tapped = -1; }
    }

    private async Task StopAll()
    {
        _step = Step.Idle;
        _at = -1;
        _tapped = -1;

        try { await JS.InvokeVoidAsync("sgaSpeech.stop"); } catch { }
        try { await JS.InvokeVoidAsync("sgaListen.stop"); } catch { }
    }

    // ---------------------------------------------------------- from the page

    [JSInvokable]
    public void OnWord(int index)
    {
        _at = index;
        StateHasChanged();
    }

    /// <summary>A single tapped word finished.</summary>
    [JSInvokable]
    public void OnSaid()
    {
        _tapped = -1;
        StateHasChanged();
    }

    /// <summary>The read-along finished. If it was the clue, it's his turn now.</summary>
    [JSInvokable]
    public async Task OnDone()
    {
        _at = -1;

        if (_step != Step.Clue)
        {
            if (_step == Step.Reading) _step = Step.Idle;
            StateHasChanged();
            return;
        }

        if (_micRefused || !await Supported())
        {
            // No microphone to listen with, so just teach him the word.
            await Correct();
            return;
        }

        _step = Step.Listening;
        StateHasChanged();

        try { await JS.InvokeVoidAsync("sgaListen.start", _self, 6); }
        catch { await Correct(); }
    }

    private async Task<bool> Supported()
    {
        try { return await JS.InvokeAsync<bool>("sgaListen.supported"); }
        catch { return false; }
    }

    [JSInvokable]
    public async Task OnHeard(string heard, string problem)
    {
        if (_step != Step.Listening) return;

        // Refused once means refused for the rest of the session; asking a
        // five-year-old to grant a microphone permission twice helps nobody.
        if (problem is "not-allowed" or "service-not-allowed") _micRefused = true;

        if (Matches(heard, _targetWord))
        {
            _step = Step.Praise;
            StateHasChanged();

            var praise = Praises[Random.Shared.Next(Praises.Length)];
            try
            {
                await JS.InvokeVoidAsync("sgaSpeech.sequence",
                    new object[] { new { text = praise, rate = 0.8, pause = 0 } }, _self);
            }
            catch { _step = Step.Idle; }

            return;
        }

        await Correct();
    }

    /// <summary>
    /// Say the sentence again, slow down before the word, say it slowly, then
    /// say it once more. Never phrased as a miss.
    /// </summary>
    private async Task Correct()
    {
        _step = Step.Correct;
        StateHasChanged();

        var slow = Math.Max(0.35, Rate - 0.35);

        try
        {
            await JS.InvokeVoidAsync("sgaSpeech.sequence", new object[]
            {
                new { text = _clue,       rate = Rate, pause = 700 },
                new { text = _targetWord, rate = slow, pause = 550 },
                new { text = _targetWord, rate = slow, pause = 0   }
            }, _self);
        }
        catch { _step = Step.Idle; }
    }

    [JSInvokable]
    public void OnSequenceDone()
    {
        _step = Step.Idle;
        StateHasChanged();
    }

    private static readonly string[] Praises =
    [
        "That's it! Great reading.",
        "Yes! You read it.",
        "Perfect. Nice job.",
        "That's the word! Well done."
    ];

    /// <summary>
    /// A five-year-old's voice through a laptop microphone is not crisp, and the
    /// engine returns several guesses. Any of them containing the word counts,
    /// and one wrong letter still counts - the point is whether he read it, not
    /// whether the microphone heard it perfectly.
    /// </summary>
    private static bool Matches(string heard, string want)
    {
        if (string.IsNullOrWhiteSpace(heard) || string.IsNullOrWhiteSpace(want)) return false;

        var target = ReadingLevel.Strip(want);
        if (target.Length == 0) return false;

        foreach (var guess in heard.Split('|', StringSplitOptions.RemoveEmptyEntries))
        {
            foreach (var word in guess.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries))
            {
                var w = ReadingLevel.Strip(word);
                if (w.Length == 0) continue;

                if (w == target) return true;
                if (target.Length >= 4 && Distance(w, target) <= 1) return true;
            }
        }

        return false;
    }

    private static int Distance(string a, string b)
    {
        if (Math.Abs(a.Length - b.Length) > 1) return 99;

        var prev = new int[b.Length + 1];
        var cur = new int[b.Length + 1];

        for (var j = 0; j <= b.Length; j++) prev[j] = j;

        for (var i = 1; i <= a.Length; i++)
        {
            cur[0] = i;

            for (var j = 1; j <= b.Length; j++)
            {
                var cost = a[i - 1] == b[j - 1] ? 0 : 1;
                cur[j] = Math.Min(Math.Min(cur[j - 1] + 1, prev[j] + 1), prev[j - 1] + cost);
            }

            (prev, cur) = (cur, prev);
        }

        return prev[b.Length];
    }

    [JSInvokable]
    public void OnUnsupported()
    {
        _step = Step.Idle;
        _unsupported = true;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Leaving the page must not leave a voice talking to an empty room, or
        // the microphone open.
        try { await JS.InvokeVoidAsync("sgaSpeech.stop"); } catch { }
        try { await JS.InvokeVoidAsync("sgaListen.stop"); } catch { }

        _self?.Dispose();
    }
}
