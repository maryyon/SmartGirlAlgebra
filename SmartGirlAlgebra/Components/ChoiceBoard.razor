@namespace SmartGirlAlgebra.Components
@inject NavigationManager Nav
@inject PlayerService Player

@* Tap-the-answer board, for children too young for algebraic notation.
   No typing, no equals sign, no keyboard. A wrong tap dims that choice and
   invites another go rather than ending the attempt — at this age the point is
   to keep her trying, not to score her. *@

<div class="sga">

    <header class="sga-header">
        <div class="sga-header__left">
            <button type="button" class="sga-iconbtn" aria-label="Back to the games"
                    @onclick="@(() => Nav.NavigateTo(Profile.Id))">🏠</button>
            @if (Profile.Lessons.Count > 0)
            {
                @* Straight to the lessons without going home first. *@
                <button type="button" class="sga-iconbtn" aria-label="Go to the lessons"
                        @onclick="@(() => Nav.NavigateTo($"{Profile.Id}/learn"))">💡</button>
            }
            <div>
                <div style="display:flex; align-items:center; gap:.375rem;">
                    <span class="sga-levelbadge" style="background-color:@Level.Color" aria-hidden="true">@Level.Id</span>
                    <h1 class="sga-title">@Level.Name</h1>
                </div>
                <p class="sga-subtitle">@Level.Difficulty</p>
            </div>
        </div>
        <span class="sga-wiggle" style="font-size:1.5rem;" aria-hidden="true">⭐</span>
    </header>

    <div class="sga-body">

        <section class="sga-problem" aria-label="The question">
            @if (Profile.ReadAloud)
            {
                <ReadAloud Listen="Profile.ListenBack" Lines="@(new List<ReadAloud.Line> {
                    new(Level.Cheer, "sga-problem__cheer sga-problem__cheer--big"),
                    new(Level.Question, "sga-ask") })" />
            }
            else if (Profile.TapToRead)
            {
                <TapWords Lines="@(new List<TapWords.Line> {
                    new(Level.Cheer, "sga-problem__cheer sga-problem__cheer--big"),
                    new(Level.Question, "sga-ask") })" />
            }
            else
            {
                <p class="sga-problem__cheer sga-problem__cheer--big sga-prewrap">@Level.Cheer</p>
                <div class="sga-ask">@Level.Question</div>
            }
        </section>

        <section class="sga-choices" aria-label="Answers">
            @foreach (var choice in Level.Choices)
            {
                var c = choice;
                var state = StateFor(c);
                <button type="button"
                        class="sga-choice @state"
                        disabled="@(_solved || _rejected.Contains(c))"
                        @onclick="@(() => Pick(c))">
                    @c
                </button>
            }
        </section>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="sga-step__msg @(_messageGood ? "sga-step__msg--ok" : "")" aria-live="polite">
                <span aria-hidden="true">@(_messageGood ? "👏" : "💬")</span>
                <span>@_message</span>
            </div>
        }

        @if (_hintIndex >= 0)
        {
            <section class="sga-hints" aria-label="Hints">
                <div class="sga-hints__eyebrow">💡 Here's a tip</div>
                @if (Profile.TapToRead)
                {
                    @* A tip she can't read is not a tip. *@
                    <TapWords Lines="@(Level.Hints.Take(_hintIndex + 1)
                        .Select(h => new TapWords.Line(h, "")).ToList())" />
                }
                else
                {
                    @foreach (var hint in Level.Hints.Take(_hintIndex + 1))
                    {
                        <p>@hint</p>
                    }
                }
            </section>
        }

        @* Younger children count and group on paper too — often more than the
           older ones do. *@
        <section aria-label="Whiteboard">
            <ScratchPad />
        </section>

    </div>

    <div class="sga-dock">
        <div class="sga-actions">
            <button type="button" class="sga-action sga-action--hint"
                    disabled="@(_hintIndex >= Level.Hints.Length - 1)"
                    @onclick="ShowHint">
                💡 @(_hintIndex < 0 ? "Need a tip?" : "Another tip")
            </button>
            <button type="button" class="sga-action sga-action--undo"
                    disabled="@(_rejected.Count == 0 || _solved)"
                    @onclick="TryAgain">
                ↩️ Try again
            </button>
        </div>

        <LevelNav Profile="Profile" Level="Level" />
    </div>

    @if (_solved)
    {
        <Celebration Answer="@Level.CorrectChoice" Headline="@_headline" Verse="_verse" OnReplay="Reset" />
    }

</div>

@code {
    [Parameter, EditorRequired] public Profile Profile { get; set; } = default!;
    [Parameter, EditorRequired] public Level Level { get; set; } = default!;

    private readonly HashSet<string> _rejected = [];
    private bool _solved;
    private int _hintIndex = -1;
    private string? _shaking;
    private int _startedLevel = -1;
    private string? _message;
    private bool _messageGood;
    private string _headline = "YOU DID IT!";
    private Verse? _verse;

    /// <summary>One of the version's lines, chosen at random.</summary>
    private static string Say(string[] options) =>
        options.Length == 0 ? "" : options[Random.Shared.Next(options.Length)];

    protected override void OnParametersSet()
    {
        if (_startedLevel == Level.Id) return;
        _startedLevel = Level.Id;
        Reset();
    }

    private void Reset()
    {
        _rejected.Clear();
        _solved = false;
        _hintIndex = -1;
        _shaking = null;
        _message = null;

        _headline = Profile.Encouragement.Solved.Length > 0
            ? Say(Profile.Encouragement.Solved)
            : "YOU DID IT!";
        _verse = Profile.Verses.Count > 0
            ? Profile.Verses[Random.Shared.Next(Profile.Verses.Count)]
            : null;
    }

    private string StateFor(string choice)
    {
        if (_solved && choice == Level.CorrectChoice) return "sga-choice--right sga-pop";
        if (_rejected.Contains(choice)) return "sga-choice--wrong";
        if (_shaking == choice) return "sga-shake";
        return "";
    }

    private async Task Pick(string choice)
    {
        if (_solved) return;

        var right = string.Equals(choice.Trim(), Level.CorrectChoice.Trim(), StringComparison.OrdinalIgnoreCase);
        var firstTry = _rejected.Count == 0;

        // The screen updates before anything touches the network. Recording an
        // attempt can wake a sleeping API and a paused database, which takes up to
        // a minute — a child must never tap an answer and watch nothing happen.
        if (right)
        {
            _solved = true;
            _message = Say(Profile.Encouragement.Correct);
            _messageGood = true;
        }
        else
        {
            _rejected.Add(choice);
            _shaking = choice;
            _message = Say(Profile.Encouragement.Wrong);
            _messageGood = false;
        }

        StateHasChanged();

        // Score the first attempt on a question, so a child who guesses through
        // every option does not earn the same streak as one who knew it.
        _ = Player.RecordAttemptAsync(correct: right && firstTry, pointsEarned: 20);

        if (right)
        {
            await Task.Delay(350);
            return;
        }

        await Task.Delay(450);
        _shaking = null;

        // After two wrong taps, surface a tip unasked rather than letting her stall.
        if (_rejected.Count >= 2 && _hintIndex < 0) ShowHint();
    }

    private void TryAgain() => _rejected.Clear();

    private void ShowHint() => _hintIndex = Math.Min(_hintIndex + 1, Level.Hints.Length - 1);
}
