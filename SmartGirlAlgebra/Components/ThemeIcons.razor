@namespace SmartGirlAlgebra.Components

@* A drifting layer of themed icons behind the content.
   These are inline SVG rather than emoji on purpose: emoji have fixed colours,
   so a lavender version would still get an orange trophy. Drawn with the
   version's own primary and accent, they stay on-palette everywhere.
   Purely decorative — aria-hidden, and it never takes a tap. *@

<div class="sga-icons" aria-hidden="true">
    @for (var i = 0; i < _placed.Count; i++)
    {
        var p = _placed[i];
        <svg class="sga-icons__i @p.Motion" viewBox="0 0 24 24"
             style="left:@(p.Left.ToString(Inv))%; top:@(p.Top.ToString(Inv))%; width:@(p.Size.ToString(Inv))px; color:@p.Colour; opacity:@(p.Opacity.ToString(Inv)); animation-duration:@(p.Duration.ToString(Inv))s; animation-delay:@(p.Delay.ToString(Inv))s;">
            <path d="@Paths[p.Name]" fill="currentColor" />
        </svg>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv =
        System.Globalization.CultureInfo.InvariantCulture;

    [Parameter, EditorRequired] public string[] Icons { get; set; } = [];

    /// <summary>How many to scatter. More reads as busy rather than lively.</summary>
    [Parameter] public int Count { get; set; } = 14;

    /// <summary>Extra brand colours to draw with. Empty falls back to primary
    /// and accent, which is right for a two-tone version and wrong for a paint box.</summary>
    [Parameter] public List<string> Palette { get; set; } = [];

    private sealed record Placed(string Name, double Left, double Top, double Size,
                                 string Colour, double Opacity, double Duration,
                                 double Delay, string Motion);

    private readonly List<Placed> _placed = [];
    private string _signature = "";

    private static readonly string[] Motions = ["sga-drift", "sga-bob", "sga-turn", "sga-throb"];

    protected override void OnParametersSet()
    {
        var signature = string.Join(",", Icons) + "|" + Count + "|" + string.Join(",", Palette);
        if (signature == _signature) return;   // keep positions stable across re-renders
        _signature = signature;

        _placed.Clear();
        if (Icons.Length == 0) return;

        // Seeded from the icon set, so a version's layout is the same every visit
        // rather than reshuffling under a child mid-session.
        var rng = new Random(signature.Aggregate(17, (h, c) => h * 31 + c));

        for (var i = 0; i < Count; i++)
        {
            var name = Icons[i % Icons.Length];
            if (!Paths.ContainsKey(name)) continue;

            _placed.Add(new Placed(
                Name: name,
                Left: Math.Round(rng.NextDouble() * 88 + 2, 2),
                Top: Math.Round(rng.NextDouble() * 92 + 2, 2),
                Size: Math.Round(22 + rng.NextDouble() * 30, 1),
                Colour: Palette.Count > 0
                    ? Palette[rng.Next(Palette.Count)]
                    : rng.NextDouble() < 0.45 ? "var(--sga-accent)" : "var(--sga-primary)",
                Opacity: Math.Round((Palette.Count > 0 ? 0.13 : 0.07) + rng.NextDouble() * 0.10, 3),
                Duration: Math.Round(7 + rng.NextDouble() * 9, 2),
                Delay: Math.Round(rng.NextDouble() * 6, 2),
                Motion: Motions[rng.Next(Motions.Length)]));
        }
    }

