@namespace SmartGirlAlgebra.Components
@inject NavigationManager Nav
@inject PlayerService Player

@* Show-your-working board: every line is checked as it is written. *@

<div class="sga">

    <header class="sga-header">
        <div class="sga-header__left">
            <button type="button" class="sga-iconbtn" aria-label="Back to level select"
                    @onclick="@(() => Nav.NavigateTo(Profile.Id))">🏠</button>
            @if (Profile.Lessons.Count > 0)
            {
                @* Straight to the lessons without going home first. *@
                <button type="button" class="sga-iconbtn" aria-label="Go to the lessons"
                        @onclick="@(() => Nav.NavigateTo($"{Profile.Id}/learn"))">💡</button>
            }
            <div>
                <div style="display:flex; align-items:center; gap:.375rem;">
                    <span class="sga-levelbadge" style="background-color:@Level.Color" aria-hidden="true">@Level.Id</span>
                    <h1 class="sga-title">@Level.Name</h1>
                </div>
                <p class="sga-subtitle">Level @Level.Id · @Level.Difficulty</p>
            </div>
        </div>
        <span class="sga-wiggle" style="font-size:1.5rem;" aria-hidden="true">📣</span>
    </header>

    <div class="sga-body">

        <section class="sga-problem" aria-label="The problem">
            <div class="sga-problem__eyebrow">✨ Today's challenge</div>
            <p class="sga-problem__cheer">@Level.Cheer</p>
            <p class="sga-problem__q">@Level.Question</p>

            <div class="sga-equation">
                <span class="sga-equation__math">@Level.Equation</span>
                <span class="sga-equation__meaning">@Level.VariableMeaning</span>
            </div>

            @if (Level.Walkthrough.Length > 0)
            {
                <button type="button" class="sga-howbtn" @onclick="@(() => _showHow = true)">
                    📖 Show me how to solve it
                </button>
            }
        </section>

        <section class="sga-steps" aria-label="Your work so far">
            @foreach (var step in _steps)
            {
                var wrong = step.Status == CheckStatus.Wrong;
                <div @key="step.Id">
                    <div class="sga-step @(wrong ? "sga-step--no" : "sga-step--ok") @(step.Id == _shakeId ? "sga-shake" : "sga-pop")">
                        <span class="sga-step__mark" aria-hidden="true">@(wrong ? "✕" : "✓")</span>
                        <span class="sga-step__text">@step.Text</span>
                        @if (step.Locked)
                        {
                            <span class="sga-step__tag">start</span>
                        }
                        <span class="visually-hidden">@(wrong ? "Incorrect line" : "Correct line")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(step.Message))
                    {
                        <div class="sga-step__msg @(wrong ? "" : "sga-step__msg--ok")">
                            <span aria-hidden="true">@(wrong ? "💬" : "👏")</span>
                            <span>@step.Message</span>
                        </div>
                    }
                </div>
            }
        </section>

        @if (_hintIndex >= 0)
        {
            <section class="sga-hints" aria-label="Hints">
                <div class="sga-hints__eyebrow">💡 Coach's tips</div>
                @foreach (var hint in Level.Hints.Take(_hintIndex + 1))
                {
                    <p>@hint</p>
                }
            </section>
        }

        <section aria-label="Whiteboard">
            <ScratchPad />
        </section>

    </div>

    <div class="sga-dock">
        <div class="sga-chips">
            @foreach (var chip in Level.Chips)
            {
                var c = chip;
                <button type="button" class="sga-chip" aria-label="Insert @c"
                        @onclick="@(() => InsertChip(c))">@c</button>
            }
        </div>

        <div class="sga-entry">
            <input class="sga-input"
                   @bind="_input"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown"
                   inputmode="text"
                   autocapitalize="off"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="Type your next line…"
                   aria-label="Type your next line of work" />
            <button type="button" class="sga-check"
                    disabled="@(string.IsNullOrWhiteSpace(_input) || _solved)"
                    @onclick="Submit">Check!</button>
        </div>

        <div class="sga-actions">
            <button type="button" class="sga-action sga-action--hint"
                    disabled="@(_hintIndex >= Level.Hints.Length - 1)"
                    @onclick="ShowHint">
                💡 @(_hintIndex < 0 ? "Need a hint?" : "Another hint")
            </button>
            <button type="button" class="sga-action sga-action--undo"
                    disabled="@(_steps.Count <= 1)"
                    @onclick="UndoLast">
                ↩️ Erase last
            </button>
        </div>

        <LevelNav Profile="Profile" Level="Level" />
    </div>

    @if (_showHow)
    {
        <div class="sga-overlay sga-overlay--bottom" role="dialog" aria-modal="true"
             aria-label="Step by step walkthrough" @onclick="@(() => _showHow = false)">
            <div class="sga-sheet sga-pop" @onclick:stopPropagation="true">
                <div class="sga-sheet__grab" aria-hidden="true"></div>
                <div class="sga-sheet__head">
                    <h2>How to solve it, step by step</h2>
                    <button type="button" class="sga-iconbtn" aria-label="Close walkthrough"
                            @onclick="@(() => _showHow = false)">✕</button>
                </div>

                <ol class="sga-walk">
                    @for (var i = 0; i < Level.Walkthrough.Length; i++)
                    {
                        var w = Level.Walkthrough[i];
                        var n = i + 1;
                        <li>
                            <div class="sga-walk__head">
                                <span class="sga-walk__num" aria-hidden="true">@n</span>
                                <h3>@w.Title</h3>
                            </div>
                            <p class="sga-walk__body">@w.Body</p>
                            <div class="sga-walk__math">@w.Math</div>
                        </li>
                    }
                </ol>

                <button type="button" class="sga-bigbtn" @onclick="@(() => _showHow = false)">
                    Got it — let's go! 📣
                </button>
            </div>
        </div>
    }

    @if (_solved)
    {
        <Celebration Answer="@Level.Answer" Headline="@_headline" Verse="_verse" OnReplay="Reset" />
    }

</div>

@code {
    [Parameter, EditorRequired] public Profile Profile { get; set; } = default!;
    [Parameter, EditorRequired] public Level Level { get; set; } = default!;

    private sealed class Step
    {
        public int Id { get; init; }
        public string Text { get; init; } = "";
        public CheckStatus Status { get; init; }
        public string? Message { get; init; }
        public bool Locked { get; init; }
    }

    private readonly List<Step> _steps = [];
    private string _input = "";
    private int _hintIndex = -1;
    private bool _solved;
    private bool _showHow;
    private int? _shakeId;
    private int _nextId = 1;
    private int _startedLevel = -1;
    private string _headline = "YOU DID IT!";
    private Verse? _verse;

    /// <summary>Chosen once per level rather than per render, so the words don't
    /// change under her while she is reading them.</summary>
    private static string Say(string[] options) =>
        options.Length == 0 ? "" : options[Random.Shared.Next(options.Length)];

    protected override void OnParametersSet()
    {
        // Only reset when we actually move to a different problem, otherwise every
        // re-render would wipe her working.
        if (_startedLevel == Level.Id) return;
        _startedLevel = Level.Id;
        Reset();
    }

    private void Reset()
    {
        _steps.Clear();
        _steps.Add(new Step { Id = 0, Text = Level.Equation, Status = CheckStatus.Correct, Locked = true });
        _input = "";
        _hintIndex = -1;
        _solved = false;
        _shakeId = null;
        _nextId = 1;

        _headline = Profile.Encouragement.Solved.Length > 0
            ? Say(Profile.Encouragement.Solved)
            : "YOU DID IT!";
        _verse = Profile.Verses.Count > 0
            ? Profile.Verses[Random.Shared.Next(Profile.Verses.Count)]
            : null;
    }

    private async Task Submit()
    {
        if (_solved) return;

        var text = _input.Trim();
        if (text.Length == 0) return;

        var result = LineChecker.Check(text, Level.AnswerValue);
        var id = _nextId++;

        // The version supplies the voice; the checker supplies only the diagnosis.
        var voice = result.Status == CheckStatus.Wrong
            ? Say(Profile.Encouragement.Wrong)
            : Say(Profile.Encouragement.Correct);

        var message = result.Status == CheckStatus.Wrong
            ? string.Join(" ", new[] { voice, result.Message }.Where(s => !string.IsNullOrWhiteSpace(s)))
            : voice;

        _steps.Add(new Step
        {
            Id = id,
            Text = text,
            Status = result.Status == CheckStatus.Solved ? CheckStatus.Correct : result.Status,
            Message = message
        });

        _input = "";
        if (result.Status == CheckStatus.Wrong) _shakeId = id;

        // The line appears before anything touches the network. Recording an attempt
        // can wake a sleeping API and a paused database, which takes up to a minute,
        // and her line must not sit invisible while that happens.
        StateHasChanged();

        // Every line counts toward her totals, right or wrong — that's what makes
        // the streak mean something.
        _ = Player.RecordAttemptAsync(
            correct: result.Status != CheckStatus.Wrong,
            pointsEarned: result.Status == CheckStatus.Solved ? 25 : 5);

        if (result.Status == CheckStatus.Wrong)
        {
            await Task.Delay(450);
            _shakeId = null;
        }
        else if (result.Status == CheckStatus.Solved)
        {
            await Task.Delay(350);
            _solved = true;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private void UndoLast()
    {
        if (_steps.Count > 1) _steps.RemoveAt(_steps.Count - 1);
    }

    private void ShowHint() => _hintIndex = Math.Min(_hintIndex + 1, Level.Hints.Length - 1);

    private void InsertChip(string chip)
    {
        var spaced = chip is "=" or "+" or "−" or "×" or "÷" ? $" {chip} " : chip;
        _input = (_input + spaced).Replace("  ", " ");
    }
}
