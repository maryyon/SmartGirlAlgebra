@namespace SmartGirlAlgebra.Components

<div class="sga-overlay sga-overlay--center" role="dialog" aria-modal="true" aria-label="You solved it">
    @foreach (var piece in _confetti)
    {
        <span class="sga-confetti"
              aria-hidden="true"
              style="left:@(piece.Left.ToString(Inv))%; font-size:@(piece.Size.ToString(Inv))px; animation-duration:@(piece.Duration.ToString(Inv))s; animation-delay:@(piece.Delay.ToString(Inv))s;">
            @piece.Emoji
        </span>
    }

    <div class="sga-win sga-bounce-in">
        <div class="sga-win__trophy sga-wiggle">🏆</div>
        <h2>@Headline</h2>

        <div class="sga-win__answer">
            <p>Your answer</p>
            <p>@Answer</p>
        </div>

        @if (Verse is not null)
        {
            <blockquote class="sga-verse">
                <p class="sga-verse__text">@Verse.Text</p>
                <cite class="sga-verse__ref">@Verse.Ref</cite>
            </blockquote>
        }

        <button type="button" class="sga-bigbtn" @onclick="OnReplay">
            Go again
        </button>
    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv =
        System.Globalization.CultureInfo.InvariantCulture;

    // Every piece here was pixel-checked for pink. Rejected: 🎉 and 🎊 (pink
    // streamers) and 🔴 (glossy sphere with a rose highlight).
    private static readonly string[] Pieces = ["📣", "✨", "🏆", "⭐", "📐", "🦅", "💙", "🔵"];

    [Parameter, EditorRequired] public string Answer { get; set; } = "";

    /// <summary>The version's own words for finishing — cheer language does not
    /// belong on a basketball or aviation version.</summary>
    [Parameter] public string Headline { get; set; } = "YOU DID IT!";

    [Parameter] public Verse? Verse { get; set; }

    [Parameter] public EventCallback OnReplay { get; set; }

    private record Piece(double Left, double Delay, double Duration, double Size, string Emoji);

    private readonly List<Piece> _confetti = [];

    protected override void OnInitialized()
    {
        var rng = Random.Shared;
        for (var i = 0; i < 28; i++)
        {
            _confetti.Add(new Piece(
                Left: Math.Round(rng.NextDouble() * 100, 2),
                Delay: Math.Round(rng.NextDouble() * 0.6, 2),
                Duration: Math.Round(2 + rng.NextDouble() * 1.8, 2),
                Size: Math.Round(18 + rng.NextDouble() * 20, 1),
                Emoji: Pieces[i % Pieces.Length]));
        }
    }
}
