@namespace SmartGirlAlgebra.Components
@using SmartGirlAlgebra.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Touch a word, hear the word.

   EVERY word can be tapped - a child stuck on a word does not first check
   whether we predicted she would be. The dotted underline marks the words above
   her reading level, so the page still points at the likely ones, but a tap
   anywhere always says something. Making only the predicted words tappable
   meant three of the five levels had nothing to tap at all, which reads exactly
   like a broken feature.

   Keyboard focus still stops only at the dotted words, so tabbing through a
   sentence does not mean forty stops. *@

<div class="sga-tap">

    @for (var li = 0; li < Lines.Count; li++)
    {
        var line = li;
        <p class="@Lines[line].Class sga-prewrap">
            @foreach (var tok in _tokens.Where(t => t.Line == line))
            {
                var t = tok;

                if (t.Key >= 0)
                {
                    <button type="button"
                            class="sga-tapword @(t.Hard ? "" : "sga-tapword--plain") @(t.Key == _saying ? "sga-tapword--on" : "")"
                            tabindex="@(t.Hard ? 0 : -1)"
                            aria-label="Hear the word @t.Text"
                            @onclick="@(() => Say(t))">@t.Text</button>
                }
                else
                {
                    @t.Text
                }

                @t.Sep
            }
        </p>
    }

    @if (_anyWords)
    {
        <p class="sga-tap__hint">
            <span aria-hidden="true">👆</span>
            Tap any word to hear it. The
            <span class="sga-tapword sga-tapword--demo">dotted</span> ones are the tricky ones.
        </p>
    }

</div>

@code {
    /// <summary>A block of text to show, with the CSS class it is normally shown in.</summary>
    public sealed record Line(string Text, string Class);

    [Parameter, EditorRequired] public IReadOnlyList<Line> Lines { get; set; } = [];

    /// <summary>Slow. The point is to hear the word, not to keep up with it.</summary>
    [Parameter] public double Rate { get; set; } = 0.5;

    private sealed record Tok(int Line, int Key, string Text, string Sep, bool Hard, string Say);

    private List<Tok> _tokens = [];
    private bool _anyWords;
    private string _signature = "";
    private int _saying = -1;

    private DotNetObjectReference<TapWords>? _self;

    protected override void OnParametersSet()
    {
        var sig = string.Join("", Lines.Select(l => l.Text));
        if (sig == _signature) return;

        _signature = sig;
        _saying = -1;
        Build();
    }

    private void Build()
    {
        _tokens = [];
        var key = 0;

        for (var li = 0; li < Lines.Count; li++)
        {
            var text = Lines[li].Text ?? "";
            var i = 0;

            while (i < text.Length)
            {
                // A token is a run of non-space; the whitespace after it is kept
                // verbatim so line breaks and blank lines survive.
                var start = i;
                while (i < text.Length && !char.IsWhiteSpace(text[i])) i++;
                var word = text[start..i];

                var sepStart = i;
                while (i < text.Length && char.IsWhiteSpace(text[i])) i++;
                var sep = text[sepStart..i];

                if (word.Length == 0)
                {
                    if (sep.Length > 0) _tokens.Add(new Tok(li, -1, "", sep, false, ""));
                    continue;
                }

                var say = ReadingLevel.Strip(word);
                var hard = ReadingLevel.IsHard(word);

                // Punctuation on its own has nothing to say, so it stays plain text.
                _tokens.Add(say.Length > 0
                    ? new Tok(li, key++, word, sep, hard, say)
                    : new Tok(li, -1, word, sep, false, ""));
            }
        }

        _anyWords = _tokens.Any(t => t.Key >= 0);
    }

    private async Task Say(Tok tok)
    {
        if (tok.Say.Length == 0) return;

        _self ??= DotNetObjectReference.Create(this);
        _saying = tok.Key;

        try
        {
            if (JS is IJSInProcessRuntime inProcess)
            {
                inProcess.InvokeVoid("sgaSpeech.say", tok.Say, Rate, _self);
            }
            else
            {
                await JS.InvokeVoidAsync("sgaSpeech.say", tok.Say, Rate, _self);
            }
        }
        catch { _saying = -1; }
    }

    [JSInvokable]
    public void OnSaid()
    {
        _saying = -1;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("sgaSpeech.stop"); }
        catch { /* the page is already going */ }

        _self?.Dispose();
    }
}
