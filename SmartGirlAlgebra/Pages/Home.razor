@page "/"
@page "/{ProfileId}"
@inject NavigationManager Nav
@inject ProfileService Profiles
@inject PlayerService Player
@inject IJSRuntime JS

<PageTitle>@(_profile?.Name ?? "Smart Girl Algebra")</PageTitle>

@if (_unknown)
{
    <UnknownVersion Requested="@(ProfileId ?? "")" Available="_index!.Available" Suggestion="_suggestion" />
}
else
{
<div class="sga">

    @if (_profile is null)
    {
        <div class="sga-body"><p>Loading…</p></div>
    }
    else
    {
        <div class="sga-body sga-body--home">

            <div style="text-align:center;">
                @if (!string.IsNullOrWhiteSpace(_profile.Crest))
                {
                    <img class="sga-crest sga-wiggle" src="@_profile.Crest" alt="" />
                }
                <h1 class="sga-hero">@_profile.Name</h1>
                <p class="sga-hero__sub">@_profile.Tagline</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_profile.HowToPlay))
            {
                <div class="sga-howto">
                    <div class="sga-howto__eyebrow">✓ How to play</div>
                    <p>@((MarkupString)_profile.HowToPlay)</p>
                </div>
            }

            @* A version whose course is generated has no stored lessons, so this
               button has to look for either. Without it there is no way in. *@
            @if (_profile.Lessons.Count > 0 || _profile.Semester)
            {
                <button type="button" class="sga-learnbtn" @onclick="@(() => Nav.NavigateTo($"{_profile.Id}/learn"))">
                    <span class="sga-learnbtn__icon" aria-hidden="true">💡</span>
                    <span class="sga-learnbtn__body">
                        <span class="sga-learnbtn__title">@(_profile.Semester ? "The course" : "Learn it first")</span>
                        <span class="sga-learnbtn__sub">
                            @(_profile.Semester
                                ? "Every step worked out, nothing to guess"
                                : "Short lessons, then try it yourself")
                        </span>
                    </span>
                    <span class="sga-levelbtn__chev" aria-hidden="true">›</span>
                </button>
            }

            <div>
                <h2 class="sga-pick__title">@_profile.LevelPickerTitle</h2>
                <p class="sga-pick__sub">@_profile.LevelPickerSubtitle</p>

                <div class="sga-levels">
                    @foreach (var level in _profile.Levels)
                    {
                        var id = level.Id;
                        <button type="button" class="sga-levelbtn" style="background-color:@level.Color"
                                @onclick="@(() => Nav.NavigateTo($"{_profile.Id}/play/{id}"))">
                            <span class="sga-levelbtn__num" aria-hidden="true">@level.Id</span>
                            <span class="sga-levelbtn__body">
                                <span class="sga-levelbtn__line">
                                    <span class="sga-levelbtn__name">@level.Name</span>
                                    <span class="sga-levelbtn__diff">@level.Difficulty</span>
                                </span>
                                <span class="sga-levelbtn__tag">@level.Tagline</span>
                            </span>
                            <span class="sga-levelbtn__chev" aria-hidden="true">›</span>
                        </button>
                    }
                </div>
            </div>

            @if (_profile.Id == "layla")
            {
                <p style="text-align:center; margin-top:.5rem;">
                    <a href="about" style="color:var(--sga-primary); font-weight:700; font-size:.875rem;">
                        📣 The secret origin story 📣
                    </a>
                </p>
            }

        </div>

        <div class="sga-footnote">
            @_profile.FooterNote
            <a href="@($"{_profile.Id}/mycode")">My code</a>
            @* Delight that can't be switched off stops being delight. *@
            <button type="button" class="sga-silly" @onclick="ToggleSilly">
                <span aria-hidden="true">@(_silly ? "🔊" : "🔇")</span>
                <span>Nana's voice @(_silly ? "on" : "off")</span>
            </button>
        </div>
    }

</div>
}

@code {
    [Parameter] public string? ProfileId { get; set; }

    private Profile? _profile;
    private bool _silly = true;
    private ProfileIndex? _index;
    private ProfileEntry? _suggestion;
    private bool _unknown;

    protected override async Task OnParametersSetAsync()
    {
        _index = await Profiles.GetIndexAsync();

        // A missing segment is fine — the domain or the default decides. A segment
        // that names nothing is a mistake, and saying so beats loading someone else's.
        _unknown = !string.IsNullOrWhiteSpace(ProfileId) && !_index.Knows(ProfileId);

        if (_unknown)
        {
            _suggestion = _index.NearestTo(ProfileId);
            _profile = null;
            return;
        }

        _suggestion = null;
        _profile = await Profiles.LoadAsync(ProfileId);
        if (_profile is not null) await Player.UseProfileAsync(_profile);

        try { _silly = !await JS.InvokeAsync<bool>("sgaTickle.muted"); }
        catch { _silly = true; }
    }

    private async Task ToggleSilly()
    {
        _silly = !_silly;

        try
        {
            await JS.InvokeVoidAsync("sgaTickle.setMuted", !_silly);

            // Switching it back on plays one, so she knows what she just allowed.
            if (_silly) await JS.InvokeVoidAsync("sgaTickle.fire");
            else await JS.InvokeVoidAsync("sgaSpeech.stop");
        }
        catch { /* no voice on this device; the setting still sticks */ }
    }
}
