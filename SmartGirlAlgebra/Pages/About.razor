@page "/about"
@inject NavigationManager Nav

<PageTitle>Our story · Smart Girl Algebra</PageTitle>

<div class="sga">

    <header class="sga-header">
        <div class="sga-header__left">
            <button type="button" class="sga-iconbtn" aria-label="Back home"
                    @onclick="@(() => Nav.NavigateTo("layla"))">🏠</button>
            <div>
                <h1 class="sga-title">Our story</h1>
                <p class="sga-subtitle">How this app came to be</p>
            </div>
        </div>
        <div class="sga-header__right">
            <SillyToggle />
            <span class="sga-wiggle" style="font-size:1.5rem;" aria-hidden="true">📣</span>
        </div>
    </header>

    <div class="sga-body">

        <section class="sga-problem" aria-label="How it started">
            <div class="sga-problem__eyebrow">✨ How Smart Girl Algebra came to life</div>

            <div class="sga-story">
                <p>
                    It all began with a <strong>beautiful, brilliant 8th grade cheerleader</strong>
                    who needed to improve her algebra skills but found the topic boring and confusing.
                </p>
                <p>
                    Her <strong>Nana</strong>, who had just learned how to <strong>VIBE CODE</strong> 💻,
                    decided that together they could create something special — a fun, engaging,
                    and educational application!
                </p>
                <p>
                    Their mission? To <strong>empower the cheerleader</strong> to learn and apply
                    algebraic strategies and master the skills she needed while
                    <strong>having fun at the same time!</strong> 📣
                </p>
                <p>
                    And of course, the app is <strong>FREE</strong>,
                    <strong>available on mobile</strong>, and will hopefully
                    <strong>inspire young girls and cheerleaders everywhere</strong>
                    to discover their inner Smart Girl Algebra connection! ⭐
                </p>
            </div>
        </section>

        <section class="sga-signature" aria-label="From the makers">
            <img src="images/heartcheer.png" alt="" aria-hidden="true" />
            <p>From Nana &amp; Her Smart Girl, With Love</p>
        </section>

        <section aria-label="Our mission">
            <div class="sga-howto">
                <div class="sga-howto__eyebrow">🏆 Our mission</div>
                <p style="font-weight:800; margin-bottom:.75rem;">
                    To make algebra accessible, fun, and empowering for every girl.
                </p>
                <ul class="sga-mission">
                    <li><strong>Free forever</strong> — education should be accessible to everyone</li>
                    <li><strong>Mobile-friendly</strong> — learn anywhere, anytime</li>
                    <li><strong>Cheer-themed</strong> — make math relatable and fun</li>
                    <li><strong>Confidence-building</strong> — every girl can master algebra</li>
                    <li><strong>Empowering</strong> — discover your inner Smart Girl</li>
                </ul>
            </div>
        </section>

        <div class="sga-crestrow" aria-hidden="true">
            <img src="images/blucheer.png" alt="" />
            <img src="images/cheery.png" alt="" />
        </div>

    </div>

    <div class="sga-dock">
        <button type="button" class="sga-bigbtn" style="margin-top:0;"
                @onclick="@(() => Nav.NavigateTo("layla"))">
            Start your journey 📣
        </button>
    </div>

</div>
