@page "/{ProfileId}/play/{LevelId:int}"
@inject NavigationManager Nav
@inject ProfileService Profiles
@inject PlayerService Player

@* One route for every version. Which board appears is the version's play mode:
   older children show their working line by line, younger ones tap an answer. *@

<PageTitle>@(_level?.Name ?? "Play")</PageTitle>

@if (_unknown)
{
    <UnknownVersion Requested="@ProfileId" Available="_index!.Available" Suggestion="_suggestion" />
}
else if (_profile is null || _level is null)
{
    <div class="sga">
        <div class="sga-body">
            @if (_profile is not null)
            {
                <p>That level doesn't exist. <a href="@_profile.Id">Back to the levels</a>.</p>
            }
            else
            {
                <p>Loading…</p>
            }
        </div>
    </div>
}
else if (_profile.Mode == PlayMode.Choice)
{
    <ChoiceBoard Profile="_profile" Level="_level" />
}
else
{
    <StepsBoard Profile="_profile" Level="_level" />
}

@code {
    [Parameter] public string ProfileId { get; set; } = "";
    [Parameter] public int LevelId { get; set; }

    private Profile? _profile;
    private Level? _level;
    private ProfileIndex? _index;
    private ProfileEntry? _suggestion;
    private bool _unknown;

    protected override async Task OnParametersSetAsync()
    {
        _index = await Profiles.GetIndexAsync();

        _unknown = !_index.Knows(ProfileId);
        if (_unknown)
        {
            _suggestion = _index.NearestTo(ProfileId);
            _profile = null;
            _level = null;
            return;
        }

        _suggestion = null;
        _profile = await Profiles.LoadAsync(ProfileId);
        if (_profile is null) return;

        await Player.UseProfileAsync(_profile);
        _level = _profile.LevelById(LevelId);
    }
}
