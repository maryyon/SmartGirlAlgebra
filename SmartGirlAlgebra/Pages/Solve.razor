@page "/solve/{LevelId:int}"
@inject NavigationManager Nav
@inject PlayerService Player

<PageTitle>@(_level?.Name ?? "Solve") · Smart Girl Algebra</PageTitle>

@if (_level is null)
{
    <div class="sga">
        <div class="sga-body">
            <p>That level doesn't exist. <a href="practice">Back to the levels</a>.</p>
        </div>
    </div>
}
else
{
    <div class="sga">

        <header class="sga-header">
            <div class="sga-header__left">
                <button type="button" class="sga-iconbtn" aria-label="Back to level select"
                        @onclick="@(() => Nav.NavigateTo(""))">🏠</button>
                <div>
                    <div style="display:flex; align-items:center; gap:.375rem;">
                        <span class="sga-levelbadge" style="background-color:@_level.Color" aria-hidden="true">@_level.Id</span>
                        <h1 class="sga-title">@_level.Name</h1>
                    </div>
                    <p class="sga-subtitle">Level @_level.Id · @_level.Difficulty</p>
                </div>
            </div>
            <span class="sga-wiggle" style="font-size:1.5rem;" aria-hidden="true">🎀</span>
        </header>

        <div class="sga-body">

            <section class="sga-problem" aria-label="The problem">
                <div class="sga-problem__eyebrow">✨ Today's cheer challenge</div>
                <p class="sga-problem__cheer">@_level.Cheer</p>
                <p class="sga-problem__q">@_level.Question</p>

                <div class="sga-equation">
                    <span class="sga-equation__math">@_level.Equation</span>
                    <span class="sga-equation__meaning">@_level.VariableMeaning</span>
                </div>

                <button type="button" class="sga-howbtn" @onclick="@(() => _showHow = true)">
                    📖 Show me how to solve it
                </button>
            </section>

            <section class="sga-steps" aria-label="Your work so far">
                @foreach (var step in _steps)
                {
                    var wrong = step.Status == CheckStatus.Wrong;
                    <div @key="step.Id">
                        <div class="sga-step @(wrong ? "sga-step--no" : "sga-step--ok") @(step.Id == _shakeId ? "sga-shake" : "sga-pop")">
                            <span class="sga-step__mark" aria-hidden="true">@(wrong ? "✕" : "✓")</span>
                            <span class="sga-step__text">@step.Text</span>
                            @if (step.Locked)
                            {
                                <span class="sga-step__tag">start</span>
                            }
                            <span class="visually-hidden">@(wrong ? "Incorrect line" : "Correct line")</span>
                        </div>

                        @if (wrong && !string.IsNullOrEmpty(step.Message))
                        {
                            <div class="sga-step__msg">
                                <span aria-hidden="true">💬</span>
                                <span>@step.Message</span>
                            </div>
                        }
                    </div>
                }
            </section>

            @if (_hintIndex >= 0)
            {
                <section class="sga-hints" aria-label="Hints">
                    <div class="sga-hints__eyebrow">💡 Coach's tips</div>
                    @foreach (var hint in _level.Hints.Take(_hintIndex + 1))
                    {
                        <p>@hint</p>
                    }
                </section>
            }

            <section aria-label="Scratch pad">
                <ScratchPad />
            </section>

        </div>

        <div class="sga-dock">
            <div class="sga-chips">
                @foreach (var chip in _level.Chips)
                {
                    <button type="button" class="sga-chip" aria-label="Insert @chip"
                            @onclick="@(() => InsertChip(chip))">@chip</button>
                }
            </div>

            <div class="sga-entry">
                <input class="sga-input"
                       @bind="_input"
                       @bind:event="oninput"
                       @onkeydown="OnKeyDown"
                       inputmode="text"
                       autocapitalize="off"
                       autocomplete="off"
                       spellcheck="false"
                       placeholder="Type your next line…"
                       aria-label="Type your next line of work" />
                <button type="button" class="sga-check"
                        disabled="@(string.IsNullOrWhiteSpace(_input) || _solved)"
                        @onclick="Submit">Check!</button>
            </div>

            <div class="sga-actions">
                <button type="button" class="sga-action sga-action--hint"
                        disabled="@(_hintIndex >= _level.Hints.Length - 1)"
                        @onclick="ShowHint">
                    💡 @(_hintIndex < 0 ? "Need a hint?" : "Another hint")
                </button>
                <button type="button" class="sga-action sga-action--undo"
                        disabled="@(_steps.Count <= 1)"
                        @onclick="UndoLast">
                    ↩️ Erase last
                </button>
            </div>
        </div>

        @if (_showHow)
        {
            <div class="sga-overlay sga-overlay--bottom" role="dialog" aria-modal="true"
                 aria-label="Step by step walkthrough" @onclick="@(() => _showHow = false)">
                <div class="sga-sheet sga-pop" @onclick:stopPropagation="true">
                    <div class="sga-sheet__grab" aria-hidden="true"></div>
                    <div class="sga-sheet__head">
                        <h2>How to solve it, step by step</h2>
                        <button type="button" class="sga-iconbtn" aria-label="Close walkthrough"
                                @onclick="@(() => _showHow = false)">✕</button>
                    </div>

                    <ol class="sga-walk">
                        @for (var i = 0; i < _level.Walkthrough.Length; i++)
                        {
                            var w = _level.Walkthrough[i];
                            var n = i + 1;
                            <li>
                                <div class="sga-walk__head">
                                    <span class="sga-walk__num" aria-hidden="true">@n</span>
                                    <h3>@w.Title</h3>
                                </div>
                                <p class="sga-walk__body">@w.Body</p>
                                <div class="sga-walk__math">@w.Math</div>
                            </li>
                        }
                    </ol>

                    <button type="button" class="sga-bigbtn" @onclick="@(() => _showHow = false)">
                        Got it — let's go! 📣
                    </button>
                </div>
            </div>
        }

        @if (_solved)
        {
            <Celebration Answer="@_level.Answer" OnReplay="Reset" />
        }

    </div>
}

@code {
    [Parameter] public int LevelId { get; set; }

    private sealed class Step
    {
        public int Id { get; init; }
        public string Text { get; init; } = "";
        public CheckStatus Status { get; init; }
        public string? Message { get; init; }
        public bool Locked { get; init; }
    }

    private Level? _level;
    private readonly List<Step> _steps = [];
    private string _input = "";
    private int _hintIndex = -1;
    private bool _solved;
    private bool _showHow;
    private int? _shakeId;
    private int _nextId = 1;

    protected override void OnParametersSet()
    {
        _level = Levels.ById(LevelId);
        Reset();
    }

    private void Reset()
    {
        _steps.Clear();
        if (_level is not null)
        {
            _steps.Add(new Step { Id = 0, Text = _level.Equation, Status = CheckStatus.Correct, Locked = true });
        }

        _input = "";
        _hintIndex = -1;
        _solved = false;
        _shakeId = null;
        _nextId = 1;
    }

    private async Task Submit()
    {
        if (_level is null || _solved) return;

        var text = _input.Trim();
        if (text.Length == 0) return;

        var result = LineChecker.Check(text, _level.AnswerValue);
        var id = _nextId++;

        _steps.Add(new Step
        {
            Id = id,
            Text = text,
            Status = result.Status == CheckStatus.Solved ? CheckStatus.Correct : result.Status,
            Message = result.Message
        });

        _input = "";

        // Every line counts toward her totals, right or wrong — that's what makes
        // the streak mean something.
        await Player.RecordAttemptAsync(
            correct: result.Status != CheckStatus.Wrong,
            pointsEarned: result.Status == CheckStatus.Solved ? 25 : 5);

        if (result.Status == CheckStatus.Wrong)
        {
            _shakeId = id;
            StateHasChanged();
            await Task.Delay(450);
            _shakeId = null;
        }
        else if (result.Status == CheckStatus.Solved)
        {
            StateHasChanged();
            await Task.Delay(350);
            _solved = true;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private void UndoLast()
    {
        if (_steps.Count > 1) _steps.RemoveAt(_steps.Count - 1);
    }

    private void ShowHint()
    {
        if (_level is null) return;
        _hintIndex = Math.Min(_hintIndex + 1, _level.Hints.Length - 1);
    }

    private void InsertChip(string chip)
    {
        var spaced = chip is "=" or "+" or "−" or "×" or "÷" ? $" {chip} " : chip;
        _input = (_input + spaced).Replace("  ", " ");
    }
}
