  "lessons": [
    {
      "id": 1,
      "title": "Counting",
      "subtitle": "One thing, one number.",
      "teach": [
        {
          "heading": "Touch and say",
          "body": "Point at one thing. Say one number. Point at the next. Say the next number. Do not skip and do not say two numbers for one thing.",
          "example": "⚽⚽⚽   one, two, three"
        },
        {
          "heading": "The last number is the answer",
          "body": "When you run out of things to point at, the last number you said is how many there are.",
          "example": "🐶🐶🐶🐶   the last one you say is four"
        }
      ],
      "practice": [
        {
          "prompt": "🐶🐶🐶",
          "question": "How many pups?",
          "choices": [
            "2",
            "3",
            "4",
            "5"
          ],
          "correct": "3",
          "explain": "One, two, three. Three pups."
