{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*.{png,jpg,gif,svg}",
      "/css/*",
      "/js/*",
      "/*.{css,js,json}"
    ]
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:;"
  },
  "routes": [
    {
      "route": "/buildinfo.json",
      "headers": {
        "Cache-Control": "no-store, must-revalidate"
      }
    },
    {
      "route": "/version.txt",
      "headers": {
        "Cache-Control": "no-store, must-revalidate"
      }
    }
  ]
}
